(defwindow bar 
    :monitor 0
    :stacking "fg"
    :wm-ignore false 
    :exclusive true
    :focusable "ondemand" 
    :geometry (geometry 
                :width "100%"
                :height "30px"
                :anchor "top center")
    (bar))

(defwidget bar []
    (box :orientation "h"
        :space-evenly true
        (box :halign "start"
            :space-evenly false
            :spacing 15
            "")
        (box :halign "center"
            :spacing 15
            time)
        (box :halign "end"
            :spacing 15
            :space-evenly false
            (battery))))

(defpoll time :interval "1s"
              :initial "initial-value"  
  `date +%H:%M:%S`)

(defwidget battery []
    "${EWW_BATTERY["BAT1"].capacity}%")
