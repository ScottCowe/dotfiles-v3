(defwindow bar 
    :monitor '["DP-3", "eDP-1"]'
    :stacking "fg"
    :wm-ignore false 
    :exclusive true
    :focusable "ondemand" 
    :geometry (geometry 
                :width "100%"
                :height "30px"
                :anchor "top center")
    (bar))

(defwidget bar []
    (box :orientation "h"
        :space-evenly true
        (box :halign "start"
            :space-evenly false
            :spacing 15
            "")
        (box :halign "center"
            :spacing 15
            time)
        (box :halign "end"
            :spacing 15
            :space-evenly false
            bluetooth
            battery)))

(defpoll time :interval "1s"
              :initial ""  
    `date +%H:%M:%S`)

(defpoll battery :interval "1s"
                 :initial ""
    `python ./scripts/battery.py`)

(defpoll bluetooth :interval "1s"
                   :initial ""
    `python ./scripts/bluetooth.py`)
