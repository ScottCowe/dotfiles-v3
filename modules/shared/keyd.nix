{
  flake.nixosModules.keyd = {
    services.keyd = {
      enable = true;
      keyboards = {
        default = {
          ids = [ "*" ];
          settings = {
            main = {
              esc = "`";
              capslock = "overload(nav, esc)";
            };
            dvorak = {
              esc = "`";
              capslock = "overload(nav, esc)";
              "'" = "-";
              "," = "w";
              "-" = "[";
              "." = "v";
              "/" = "z";
              ";" = "s";
              "=" = "]";
              "[" = "/";
              "]" = "=";
              b = "x";
              c = "j";
              d = "e";
              e = ".";
              f = "u";
              g = "i";
              h = "d";
              i = "c";
              j = "h";
              k = "t";
              l = "n";
              m = "m";
              n = "b";
              o = "r";
              p = "l";
              q = "'";
              r = "p";
              s = "o";
              t = "y";
              u = "g";
              v = "k";
              w = ",";
              x = "q";
              y = "f";
              z = ";";
              shift = "layer(dvorak_shift)";
            };
            "dvorak_shift:S" = {
              "'" = "_";
              "," = "W";
              "-" = "{";
              "." = "V";
              "/" = "Z";
              "1" = "!";
              "2" = "@";
              "3" = "#";
              "4" = "$";
              "5" = "%";
              "6" = "^";
              "7" = "&";
              "8" = "*";
              "9" = "(";
              ";" = "S";
              "=" = "}";
              "[" = "?";
              "\\" = "|";
              "]" = "+";
              a = "A";
              b = "X";
              c = "J";
              d = "E";
              e = ">";
              f = "U";
              g = "I";
              h = "D";
              i = "C";
              j = "H";
              k = "T";
              l = "N";
              m = "M";
              n = "B";
              o = "R";
              p = "L";
              q = "\"";
              r = "P";
              s = "O";
              t = "Y";
              u = "G";
              v = "K";
              w = "<";
              x = "Q";
              y = "F";
              z = ":";
            };
            nav = {
              esc = "capslock";
              h = "left";
              j = "down";
              k = "up";
              l = "right";
              "1" = "f1";
              "2" = "f2";
              "3" = "f3";
              "4" = "f4";
              "5" = "f5";
              "6" = "f8";
              "7" = "f7";
              "8" = "f8";
              "9" = "f9";
              "0" = "f10";
              q = "setlayout(main)";
              w = "toggle(dvorak)";
            };
          };
        };
      };
    };
  };
}
